{
  "name": "hotel-concierge-ai",
  "version": "1.0.0",
  "description": "AI-powered hotel assistant for guest queries via interactive CLI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm test",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
